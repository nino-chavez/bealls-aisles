{
  "name": "@signalx/aisles",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:cloudflare": "tsx scripts/cloudflare-current-preview.mjs build",
    "verify:cloudflare": "tsx scripts/cloudflare-current-preview.mjs verify",
    "deploy:cloudflare": "tsx scripts/cloudflare-current-preview.mjs deploy",
    "smoke:cloudflare": "tsx scripts/cloudflare-current-preview.mjs smoke",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:renderer-contract": "tsx src/lib/brand/bealls-family-renderer-contract.test.ts",
    "test:runtime-contract": "tsx src/lib/brand/bealls-family-runtime-contract.test.ts",
    "test:contracts": "npm run test:runtime-contract && npm run test:renderer-contract",
		"test:all": "for test_file in $(find src -name '*.test.ts' -type f | sort); do tsx \"$test_file\" || exit 1; done",
		"test:commerce": "vitest run src/lib/commerce src/lib/server/commerce",
		"test:commerce:browser": "playwright test tests/commerce-rendered.spec.ts",
		"test": "npm run test:all && npm run test:commerce",
    "capture:runtime-parity": "node scripts/capture-runtime-parity.mjs",
    "warm-images": "npx tsx scripts/cache/warm-bc-images.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/adapter-vercel": "^5.7.0",
    "@sveltejs/kit": "^2.21.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "playwright": "^1.59.1",
    "svelte": "^5.28.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.123.0"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.66",
    "@ai-sdk/gateway": "^3.0.88",
    "@neondatabase/serverless": "^1.0.2",
    "@openrouter/ai-sdk-provider": "^2.3.3",
    "@phosphor-icons/react": "^2.1.10",
    "@upstash/redis": "^1.37.0",
    "ai": "^6.0.146",
    "dotenv": "^17.4.0",
    "zod": "^4.3.6"
  }
}
